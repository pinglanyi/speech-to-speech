# Copy to .env; never commit .env. Shell expressions are NOT evaluated.
# Choose deepseek (official, default) or bailian. Keys are never interchangeable.
# 使用方法：只在 .env 修改生效值；下面带 # 的型号是备选说明，不要同时取消多行注释。
# 模型目录/ID 必须匹配所选后端；修改后重启，网页刷新。空值沿用所选后端默认。
# Hub ID 首次启动自动走 HF_ENDPOINT 下载；本地路径必须事先完整准备好。
# 示例并非封闭白名单，兼容相同架构的其他仓库/微调模型也可填入，需自行验证。
# 型号列表不是逐一推理通过的保证；Faster Whisper 简写以实际安装版本的映射为准。
S2S_LLM_PROVIDER=deepseek

# DeepSeek official API. Fill this key when using the default provider.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# 官方 API 型号：deepseek-flash（默认）、deepseek-v4-pro。
# 只远程调用，不下载到服务器；Key 的权限、余额与模型可用性由官方平台决定。
# 型号参考：https://api-docs.deepseek.com/quick_start/pricing/
# none disables thinking for faster voice replies; low/high/max enable thinking.
DEEPSEEK_REASONING_EFFORT=none

# Optional Bailian provider. Only read when S2S_LLM_PROVIDER=bailian.
# DASHSCOPE_API_KEY=
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# DASHSCOPE_MODEL=qwen-plus
# 百炼文本模型示例：qwen-plus、qwen-flash、qwen-max、qwen-turbo。
# 其他支持 Chat Completions 文本对话的百炼模型也可填入；以对应地域控制台为准。
# 不要把 TTS/ASR/图像生成专用模型填到 DASHSCOPE_MODEL。
# 型号参考：https://www.alibabacloud.com/help/en/model-studio/models

# auto, gpu, or cpu; command-line --gpu/--cpu overrides this value.
S2S_PROFILE=auto

# Model selection. Blank model/language/dtype fields use backend/profile defaults.
# auto: GPU uses qwen3-asr + qwen3; CPU uses faster-whisper + omnivoice.
# A model must match its backend architecture. Changes require a restart.
# STT choices: auto, qwen3-asr, faster-whisper, whisper.
S2S_STT_BACKEND=auto
# Qwen default: Qwen/Qwen3-ASR-1.7B-hf; smaller: Qwen/Qwen3-ASR-0.6B-hf.
# Faster Whisper default: small; accepts size, CTranslate2 Hub ID, or local path.
# Whisper default: openai/whisper-small; accepts Transformers Hub ID/local path.
# -------- S2S_STT_BACKEND=qwen3-asr：Transformers 格式 --------
# Qwen/Qwen3-ASR-1.7B-hf     默认，1.7B
# Qwen/Qwen3-ASR-0.6B-hf     较小，0.6B
# /models/qwen3-asr         兼容的完整本地模型目录
# 注意本项目使用带 -hf 的转换格式，不要直接换成其他加载器专用仓库。
#
# -------- S2S_STT_BACKEND=faster-whisper：CTranslate2 格式 --------
# 多语言名称：tiny、base、small（默认）、medium、large-v1、large-v2、large-v3。
# 其他名称：large（指向 large-v3）、large-v3-turbo、turbo。
# 英语专用：tiny.en、base.en、small.en、medium.en；中文请用不带 .en 的型号。
# 蒸馏名称：distil-small.en、distil-medium.en、distil-large-v2、distil-large-v3、
#           distil-large-v3.5（蒸馏模型请确认其语言支持）。
# 仓库示例：Systran/faster-whisper-small、Systran/faster-whisper-large-v3。
# 本地示例：/models/faster-whisper-large-v3（已经转换成 CTranslate2 的目录）。
# 名称映射：https://github.com/SYSTRAN/faster-whisper/blob/master/faster_whisper/utils.py
#
# -------- S2S_STT_BACKEND=whisper：Transformers 格式 --------
# openai/whisper-tiny、openai/whisper-base、openai/whisper-small（默认）、
# openai/whisper-medium、openai/whisper-large-v2、openai/whisper-large-v3、
# openai/whisper-large-v3-turbo。
# 英语专用示例：openai/whisper-tiny.en、openai/whisper-base.en、
#               openai/whisper-small.en、openai/whisper-medium.en。
# 本地示例：/models/whisper-small（完整 Transformers 模型目录）。
# 不要把 openai/whisper-* 的原始权重交给 faster-whisper 加载。
S2S_STT_MODEL=
S2S_STT_LANGUAGE=zh
# Torch STT: auto/float16/bfloat16/float32. Blank: GPU float16, CPU float32.
S2S_STT_DTYPE=
# Faster Whisper only. Blank: GPU float16, CPU int8.
S2S_STT_COMPUTE_TYPE=

# TTS choices: auto, qwen3 (GPU), omnivoice (GPU or CPU).
S2S_TTS_BACKEND=auto
# Qwen default: Qwen/Qwen3-TTS-12Hz-1.7B-CustomVoice.
# OmniVoice default: k2-fsa/OmniVoice. Hub ID or matching local model directory.
# -------- S2S_TTS_BACKEND=qwen3：本启动器使用 GPU + torch --------
# Qwen/Qwen3-TTS-12Hz-1.7B-CustomVoice  默认，预设音色
# Qwen/Qwen3-TTS-12Hz-0.6B-CustomVoice  较小，预设音色
# Qwen/Qwen3-TTS-12Hz-1.7B-Base         音色克隆，须填 REF_AUDIO + REF_TEXT
# Qwen/Qwen3-TTS-12Hz-0.6B-Base         较小，音色克隆，须填参考音频和文本
# Qwen/Qwen3-TTS-12Hz-1.7B-VoiceDesign  音色设计，须填 S2S_TTS_INSTRUCT
# /models/qwen3-tts-customvoice        对应架构的完整本地模型目录
# Base 和 VoiceDesign 不按 S2S_TTS_VOICE 的预设名字选择音色。
# 部分模型会额外加载 Qwen/Qwen3-TTS-Tokenizer-12Hz；这是内部 codec，
# 不是 S2S_TTS_MODEL 的可替代值。
# 模型/音色：https://huggingface.co/Qwen/Qwen3-TTS-12Hz-1.7B-CustomVoice
#
# -------- S2S_TTS_BACKEND=omnivoice：GPU 或 CPU --------
# k2-fsa/OmniVoice                    默认，支持中文
# /models/omnivoice                   兼容的完整本地模型目录
# S2S_TTS_VOICE 必须留空；可用参考音频+文本克隆，或 INSTRUCT 描述音色。
# 模型权重许可证为 CC-BY-NC，商用需另行确认授权。
# 模型说明：https://huggingface.co/k2-fsa/OmniVoice
S2S_TTS_MODEL=
# Qwen: chinese/english/etc.; OmniVoice: Chinese/English/etc. Blank=Chinese.
S2S_TTS_LANGUAGE=
S2S_TTS_DTYPE=
# Qwen preset speaker, default Vivian. Leave blank for OmniVoice.
# Qwen CustomVoice 预设：Vivian、Serena、Uncle_Fu、Dylan、Eric、
#                       Ryan、Aiden、Ono_Anna、Sohee。
# 具体可用音色由所选权重决定，不要将这些名字用于 OmniVoice。
S2S_TTS_VOICE=
# Optional cloning reference: set BOTH audio path and matching transcript.
S2S_TTS_REF_AUDIO=
S2S_TTS_REF_TEXT=
# Optional voice-design instruction (requires a compatible model).
S2S_TTS_INSTRUCT=
S2S_SYSTEM_PROMPT=你是中文语音助手。请用简洁自然的中文回答，通常不超过三句话。

# VAD choices: silero (bundled weights) or firered (local Stream-VAD weights).
S2S_VAD_BACKEND=silero
S2S_FIRERED_MODEL_DIR=
# firered：填写 FireRed Stream-VAD 本地权重目录（应包含 cmvn.ark 等文件）。
# 此字段不是 Hub ID；脚本会装 fireredvad 依赖，但不会代为下载该目录。
# Optional compatible Silero TorchScript file; blank uses bundled Silero.
S2S_SILERO_MODEL_PATH=
# silero 默认模型随 silero-vad==5.1.2 安装；通常保持空值。
# 自定义示例：/models/vad/silero_vad.jit（兼容的 TorchScript，不是 ONNX）。
# Smart Turn v3.2 CPU ONNX: 1=on, 0=off. Blank path uses mirror download.
S2S_SMART_TURN=1
S2S_SMART_TURN_MODEL_PATH=
# 默认仓库 pipecat-ai/smart-turn-v3，文件 smart-turn-v3.2-cpu.onnx。
# 自定义示例：/models/turn/smart-turn-v3.2-cpu.onnx。
# 此处只能填兼容 Smart Turn v3.x CPU ONNX 文件路径，不能直接填 Hub ID。
# Always installed in both venv profiles. 0=off, 1=DeepFilterNet denoising.
S2S_AUDIO_ENHANCEMENT=0
# Optional compatible DeepFilterNet Rust model .tar.gz; blank uses bundled model.
S2S_DEEPFILTER_MODEL_PATH=
# 默认模型随 deepfilternet-rs==0.1.1 安装，不需要单独下载。
# 自定义示例：/models/denoise/DeepFilterNet3.tar.gz。
# 必须是该 Rust 运行时支持的模型归档，不是任意 PyTorch checkpoint。
#
# 上游还支持 Parakeet、Paraformer、SenseVoice、ChatTTS、Kokoro、Pocket、
# MiniMax、Supertonic 等，但尚未接入本启动器的通用 S2S_* 后端选择。
# 它们不能直接填进上述 BACKEND 字段；需要扩展启动器或使用上游 CLI 配置。
S2S_PORT=8765
S2S_DEMO_PORT=7860
# Model warmup/download can take many minutes on first startup.
S2S_STARTUP_TIMEOUT=1800
# Model downloads use the mirror by default; set another endpoint if needed.
HF_ENDPOINT=https://hf-mirror.com
HF_HUB_DISABLE_XET=1
# Load bundled Silero VAD weights, avoiding a separate GitHub model download.
S2S_PACKAGED_SILERO=1
# Optional single NLTK resource directory. Unset: .runtime/nltk_data (private).
# NLTK downloads are separate from HF_ENDPOINT; offline instructions in docs.
# NLTK_DATA=/home/your-user/nltk_data
