# Copy to .env; never commit .env. Shell expressions are NOT evaluated.
# Choose deepseek (official, default) or bailian. Keys are never interchangeable.
S2S_LLM_PROVIDER=deepseek

# DeepSeek official API. Fill this key when using the default provider.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# none disables thinking for faster voice replies; low/high/max enable thinking.
DEEPSEEK_REASONING_EFFORT=none

# Optional Bailian provider. Only read when S2S_LLM_PROVIDER=bailian.
# DASHSCOPE_API_KEY=
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# DASHSCOPE_MODEL=qwen-plus

# auto, gpu, or cpu; command-line --gpu/--cpu overrides this value.
S2S_PROFILE=auto

# Model selection. Blank model/language/dtype fields use backend/profile defaults.
# auto: GPU uses qwen3-asr + qwen3; CPU uses faster-whisper + omnivoice.
# A model must match its backend architecture. Changes require a restart.
# STT choices: auto, qwen3-asr, faster-whisper, whisper.
S2S_STT_BACKEND=auto
# Qwen default: Qwen/Qwen3-ASR-1.7B-hf; smaller: Qwen/Qwen3-ASR-0.6B-hf.
# Faster Whisper default: small; accepts size, CTranslate2 Hub ID, or local path.
# Whisper default: openai/whisper-small; accepts Transformers Hub ID/local path.
S2S_STT_MODEL=
S2S_STT_LANGUAGE=zh
# Torch STT: auto/float16/bfloat16/float32. Blank: GPU float16, CPU float32.
S2S_STT_DTYPE=
# Faster Whisper only. Blank: GPU float16, CPU int8.
S2S_STT_COMPUTE_TYPE=

# TTS choices: auto, qwen3 (GPU), omnivoice (GPU or CPU).
S2S_TTS_BACKEND=auto
# Qwen default: Qwen/Qwen3-TTS-12Hz-1.7B-CustomVoice.
# OmniVoice default: k2-fsa/OmniVoice. Hub ID or matching local model directory.
S2S_TTS_MODEL=
# Qwen: chinese/english/etc.; OmniVoice: Chinese/English/etc. Blank=Chinese.
S2S_TTS_LANGUAGE=
S2S_TTS_DTYPE=
# Qwen preset speaker, default Vivian. Leave blank for OmniVoice.
S2S_TTS_VOICE=
# Optional cloning reference: set BOTH audio path and matching transcript.
S2S_TTS_REF_AUDIO=
S2S_TTS_REF_TEXT=
# Optional voice-design instruction (requires a compatible model).
S2S_TTS_INSTRUCT=
S2S_SYSTEM_PROMPT=你是中文语音助手。请用简洁自然的中文回答，通常不超过三句话。

# VAD choices: silero (bundled weights) or firered (local Stream-VAD weights).
S2S_VAD_BACKEND=silero
S2S_FIRERED_MODEL_DIR=
# Optional compatible Silero TorchScript file; blank uses bundled Silero.
S2S_SILERO_MODEL_PATH=
# Smart Turn v3.2 CPU ONNX: 1=on, 0=off. Blank path uses mirror download.
S2S_SMART_TURN=1
S2S_SMART_TURN_MODEL_PATH=
# Always installed in both venv profiles. 0=off, 1=DeepFilterNet denoising.
S2S_AUDIO_ENHANCEMENT=0
# Optional compatible DeepFilterNet Rust model .tar.gz; blank uses bundled model.
S2S_DEEPFILTER_MODEL_PATH=
S2S_PORT=8765
S2S_DEMO_PORT=7860
# Model warmup/download can take many minutes on first startup.
S2S_STARTUP_TIMEOUT=1800
# Model downloads use the mirror by default; set another endpoint if needed.
HF_ENDPOINT=https://hf-mirror.com
HF_HUB_DISABLE_XET=1
# Load bundled Silero VAD weights, avoiding a separate GitHub model download.
S2S_PACKAGED_SILERO=1
# Optional single NLTK resource directory. Unset: .runtime/nltk_data (private).
# NLTK downloads are separate from HF_ENDPOINT; offline instructions in docs.
# NLTK_DATA=/home/your-user/nltk_data
